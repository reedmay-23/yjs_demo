generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int                    @id @default(autoincrement())
  username              String                 @unique @db.VarChar(100)
  password              String                 @default("") @db.VarChar(255)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  account               String                 @db.VarChar(100)
  refreshToken          String?
  sessions              CollaborationSession[] @relation("UserSessions")
  documents             Document[]             @relation("UserDocuments")
  documentHistories     DocumentHistory[]
  documentUpdates       DocumentUpdate[]
  documentCollaborators DocumentCollaborator[]
  collaboratorInvites   DocumentCollaborator[] @relation("DocumentCollaboratorInviter")

  @@map("users")
}

model Document {
  id                    Int                    @id @default(autoincrement())
  title                 String                 @db.VarChar(255)
  summary               String?                @db.VarChar(1000)
  status                String                 @default("active") @db.VarChar(32)
  createdBy             Int                    @map("create_by")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  version               Int                    @default(0) @map("version")
  content               Json
  sessions              CollaborationSession[] @relation("DocumentSessions")
  histories             DocumentHistory[]
  updates               DocumentUpdate[]
  creator               User                   @relation("UserDocuments", fields: [createdBy], references: [id])
  documentCollaborators DocumentCollaborator[]

  @@map("documents")
}

model DocumentHistory {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  userId     Int      @map("user_id")
  version    Int
  action     String   @db.VarChar(32) // edit, rollback, metadata_update
  summary    String?  @db.VarChar(500)
  content    Json? // Y.Doc 快照 number[]
  createdAt  DateTime @default(now()) @map("created_at")

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])
  sourceVersion Int?     @map("source_version")

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
  @@map("document_histories")
}

model DocumentUpdate {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  userId     Int?     @map("user_id")
  update     Json
  byteLength Int      @map("byte_length")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
  @@map("document_updates")
}

model CollaborationSession {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  userId     Int      @map("user_id")
  cursorPos  Json?    @map("cursor_pos")
  isActive   Boolean  @default(true) @map("is_active")
  lastSeen   DateTime @default(now()) @map("last_seen")
  document   Document @relation("DocumentSessions", fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation("UserSessions", fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([lastSeen])
  @@map("collaboration_sessions")
}

// 文档写作表 用来看哪个人有 查看文档的权限
model DocumentCollaborator {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  userId     Int      @map("user_id")
  role       String   @default("editor") @db.VarChar(32) // editor 写作者 viewer 只读 owner 创建人
  createdBy  Int      @map("created_by") // 邀请人
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter  User     @relation("DocumentCollaboratorInviter", fields: [createdBy], references: [id])

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
  @@map("document_collaborators")
}
