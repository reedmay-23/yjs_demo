generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int                    @id @default(autoincrement())
  username     String                 @unique @db.VarChar(100)
  password     String                 @default("") @db.VarChar(255)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  account      String                 @db.VarChar(100)
  refreshToken String?
  sessions     CollaborationSession[] @relation("UserSessions")
  documents    Document[]             @relation("UserDocuments")

  @@map("users")
}

model Document {
  id        Int                    @id @default(autoincrement())
  title     String                 @db.VarChar(255)
  createdBy Int                    @map("create_by")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  version   Int                    @default(0) @map("version")
  content   Json
  sessions  CollaborationSession[] @relation("DocumentSessions")
  creator   User                   @relation("UserDocuments", fields: [createdBy], references: [id])

  @@map("documents")
}

model CollaborationSession {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  userId     Int      @map("user_id")
  cursorPos  Json?    @map("cursor_pos")
  isActive   Boolean  @default(true) @map("is_active")
  lastSeen   DateTime @default(now()) @map("last_seen")
  document   Document @relation("DocumentSessions", fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation("UserSessions", fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([lastSeen])
  @@map("collaboration_sessions")
}
